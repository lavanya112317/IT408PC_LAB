abstract class Animal {
    abstract public void sound();
}

class Lion extends Animal {
    public void sound() {
        System.out.println("Lion sound");
    }
}

class Tiger extends Animal {
    public void sound() {
        System.out.println("Tiger sound");
    }
}

class Inheritance2 {
    public static void main(String[] args) {
        Animal a = new Tiger();   
        a.sound();
        Animal b = new Lion();
        b.sound();

    }
}
